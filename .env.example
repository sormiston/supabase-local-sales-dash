# Local Supabase API URL (from `supabase status`, default local port 54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase publishable/anon key (from `supabase status`)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Local Supabase secret key (from `supabase status`), used only in tests/testAuth.ts's
# createServiceRoleClient() to tear down rows created during test runs. Set in .env.test,
# not this file (never sourced by the app itself).
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
